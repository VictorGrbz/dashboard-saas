{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{const j=JSON.parse(d);const f=(j.tool_input&&j.tool_input.file_path)||'';if(/\\.(ts|tsx)$/.test(f)){require('child_process').execSync('npx tsc --noEmit',{stdio:'inherit',cwd:process.cwd()});}}catch(e){}});\"",
            "shell": "bash",
            "timeout": 60,
            "statusMessage": "Vérification des types (tsc --noEmit)..."
          }
        ]
      }
    ]
  }
}
